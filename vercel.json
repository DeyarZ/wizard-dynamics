{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/go/grass",
      "destination": "https://grassidentifier.wizarddynamics.com/go",
      "permanent": false
    },
    { "source": "/contact", "destination": "/estimate", "permanent": false },
    { "source": "/construction", "destination": "/", "permanent": false },
    { "source": "/scroll", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/estimate/:view", "destination": "/estimate" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/video/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
